MONGODB_URL="mongodb://document_qa_api_user:<password>@<host-0>:27017,<host-1>:27017,<host-2>:27017/?ssl=true&replicaSet=atlas-xxxxxx-shard-0&authSource=admin&retryWrites=true&w=majority"
GEMINI_AI_API_KEY="xx-xxx"
DEEPSEEK_API_KEY="xx-xxx"
VOYAGE_API_KEY="xx-xxx"

# LLM Provider: "gemini", "deepseek", or "modal"
LLM_PROVIDER="gemini"

# Vector Store: "mongodb" (Atlas Vector Search) or "faiss" (local)
VECTOR_STORE="mongodb"

# JWT Authentication
# Generate secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate password hash: python scripts/hash_password.py "your-password"
JWT_SECRET_KEY="your-secret-key-min-32-chars"
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30
DEMO_USER_EMAIL="demo@example.com"
DEMO_USER_PASSWORD_HASH="$2b$12$..."

# Modal LLM Configuration (for self-hosted LLM on Modal)
MODAL_LLM_URL="https://nicolasjapas--vllm-openai-server-serve.modal.run/v1"
MODAL_MODEL_NAME="Qwen/Qwen3-1.7B"
MODAL_KEY="your-modal-key"
MODAL_SECRET="your-modal-secret"

# Rate Limiting Configuration
GLOBAL_DAILY_REQUEST_LIMIT=100
MAX_FILE_SIZE_MB=10
MAX_CHUNKS_PER_DOCUMENT=100
MAX_DOCUMENTS_TOTAL=50
RATE_LIMIT_UPLOADS_PER_HOUR="5/hour"
RATE_LIMIT_QUESTIONS_PER_HOUR="30/hour"

# Email Notification Configuration (for rate limit alerts)
# Use Gmail with App Password, SendGrid SMTP, or any SMTP provider
ALERT_EMAIL="your-email@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-smtp-user@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@your-domain.com"

# Render API Configuration (for scripts/switch_llm.py - local use only)
RENDER_API_KEY="your-render-api-key"
RENDER_SERVICE_ID="your-render-service-id"
